rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Base helper: Check if request has an authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 1. Families Collection (Family groups & invite codes)
    match /families/{familyId} {
      allow read, write: if true;
    }

    // 2. Family Members Collection (Parent/Child roles & devices)
    match /family_members/{memberDocId} {
      allow read, write: if true;
    }

    // 3. Expenses Collection (Multi-device shared expense transactions)
    match /expenses/{expenseUuid} {
      allow read, write: if true;
    }
  }
}
